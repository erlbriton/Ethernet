#Generating source browse information for project r006


#Abbreviations
cc = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.4\common\bin\SourceIndexer.exe
ll = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.4\common\bin\PbdLink.exe
bd = C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 8.4\common\bin\makeBrowseData.exe



#Rules
rule index
  depfile = $out.dep
  command = $cc -out=$out -f $in
rule link
  command = $ll -M $out $in
rule browsedata
  command = $bd $in -output  $out



#Build steps
build clock-arch.pbi : index clock-arch.xcl
build timer.pbi : index timer.xcl
build lnkmngr_u3.pbi : index lnkmngr_u3.xcl
build DExS_mem_struct.pbi : index DExS_mem_struct.xcl
build flash_data.pbi : index flash_data.xcl
build memutil.pbi : index memutil.xcl
build ramdata.pbi : index ramdata.xcl
build crc16.pbi : index crc16.xcl
build modbus.pbi : index modbus.xcl
build uart.pbi : index uart.xcl
build uart1rs485.pbi : index uart1rs485.xcl
build LPC23xx_enet.pbi : index LPC23xx_enet.xcl
build tcp_ctrl.pbi : index tcp_ctrl.xcl
build tcpip_uart_bridge.pbi : index tcpip_uart_bridge.xcl
build uip.pbi : index uip.xcl
build uip_arp.pbi : index uip_arp.xcl
build base64.pbi : index base64.xcl
build sha1.pbi : index sha1.xcl
build uip_app_dispatch.pbi : index uip_app_dispatch.xcl
build websocket_server.pbi : index websocket_server.xcl
build ws_uart_bridge.pbi : index ws_uart_bridge.xcl
build init.pbi : index init.xcl
build main.pbi : index main.xcl
build r006_part0.pbi : link clock-arch.pbi timer.pbi lnkmngr_u3.pbi DExS_mem_struct.pbi flash_data.pbi
build r006_part1.pbi : link memutil.pbi ramdata.pbi crc16.pbi modbus.pbi uart.pbi
build r006_part2.pbi : link uart1rs485.pbi LPC23xx_enet.pbi tcp_ctrl.pbi tcpip_uart_bridge.pbi uip.pbi
build r006_part3.pbi : link uip_arp.pbi base64.pbi sha1.pbi uip_app_dispatch.pbi websocket_server.pbi
build r006_part4.pbi : link ws_uart_bridge.pbi init.pbi main.pbi
build r006.pbd : link r006_part0.pbi r006_part1.pbi r006_part2.pbi r006_part3.pbi r006_part4.pbi
build r006.pbw : browsedata r006.pbd


